{
    "name": "@akms/mcp-db",
    "version": "0.1.0",
    "description": "MCP server that lets an AI agent query one pre-registered database — directly or through an SSH tunnel — behind a parser-based guard.",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "postgres",
        "postgresql",
        "ssh-tunnel",
        "database"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/juncha9/npm.akms.mcp-db.git"
    },
    "homepage": "https://github.com/juncha9/npm.akms.mcp-db#readme",
    "bugs": {
        "url": "https://github.com/juncha9/npm.akms.mcp-db/issues"
    },
    "type": "module",
    "main": "./lib/index.cjs",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "bin": {
        "akms-mcp-db": "lib/cli.js"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            },
            "require": {
                "types": "./lib/index.d.cts",
                "default": "./lib/index.cjs"
            }
        }
    },
    "files": [
        "lib",
        "README.md",
        "LICENSE.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc --noEmit && rimraf ./lib && tsup",
        "watch": "tsc --noEmit && tsup --watch",
        "dev": "tsx ./src/cli.ts",
        "start": "node ./lib/cli.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.1",
        "libpg-query": "^18.1.5",
        "pg": "^8.23.0",
        "pg-cursor": "^2.22.0",
        "ssh2": "^1.17.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@electric-sql/pglite-socket": "^0.2.11",
        "@types/node": "^24.19.0",
        "@types/pg": "^8.23.1",
        "@types/pg-cursor": "^2.7.2",
        "@types/ssh2": "^1.15.6",
        "@vitest/coverage-v8": "^4.1.11",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
